generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   // bcrypt hash
  coupleId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  couple           Couple?          @relation(fields: [coupleId], references: [id])
  authSessions     AuthSession[]
  sessions         Session[]
  counselorProfile CounselorProfile?
  surveySessions   SurveySession[]
  assignments      Assignment[]

  @@index([email])
}

// Server-side auth sessions (token stored in httpOnly cookie)
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ─── Couple ───────────────────────────────────────────────────────────────────

model Couple {
  id         String   @id @default(cuid())
  inviteCode String   @unique // 6-char alphanumeric
  createdAt  DateTime @default(now())

  members        User[]
  sessions       Session[]
  surveySessions SurveySession[]
}

// ─── Counseling Session ───────────────────────────────────────────────────────

model Session {
  id                String   @id @default(cuid())
  userId            String
  coupleId          String?
  counselorName     String   @default("상담사")
  status            String   @default("active") // active, completed, crisis
  conflictType      String?  // communication, finance, parenting, infidelity, inlaw, intimacy
  onboardingDone    Boolean  @default(false)
  crisisLevel       String?  // CRITICAL, WARNING, WATCH
  watchCount        Int      @default(0)
  surveyContextJson String?  // Serialized AIContextPayload from survey scoring
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  couple        Couple?        @relation(fields: [coupleId], references: [id])
  messages      Message[]
  emotionStates EmotionState[]
  assignments   Assignment[]

  @@index([userId])
  @@index([coupleId])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // user, assistant, system
  content   String
  metadata  String?  // JSON: crisis detection results, emotion tags
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model EmotionState {
  id        String   @id @default(cuid())
  sessionId String
  emotion   String   // e.g. anger, sadness, fear, shame, loneliness
  intensity Float    // 0.0 ~ 1.0
  source    String?  // what triggered this emotion
  context   String?  // additional analysis context
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

// ─── Survey ───────────────────────────────────────────────────────────────────

model SurveySession {
  id          String    @id @default(cuid())
  userId      String
  coupleId    String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  couple  Couple?       @relation(fields: [coupleId], references: [id])
  answers SurveyAnswer[]

  @@index([userId])
}

model SurveyAnswer {
  id              String   @id @default(cuid())
  surveySessionId String
  questionId      String   // e.g. "conflict_type", "relationship_duration"
  answer          String   // JSON-serialized value
  createdAt       DateTime @default(now())

  surveySession SurveySession @relation(fields: [surveySessionId], references: [id], onDelete: Cascade)

  @@index([surveySessionId])
}

// ─── Assignment (상담 과제) ──────────────────────────────────────────────────

model Assignment {
  id          String    @id @default(cuid())
  sessionId   String
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  session Session @relation(fields: [sessionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
}

// ─── Counselor ────────────────────────────────────────────────────────────────

model CounselorProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String
  avatarUrl   String?
  specialty   String?
  user        User    @relation(fields: [userId], references: [id])
}
