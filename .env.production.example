# === Database (Turso) ===
# Turso 프로덕션 DB URL (libsql:// 프로토콜)
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# === Claude API ===
ANTHROPIC_API_KEY=sk-ant-api03-your-production-key

# === Sentry 에러 모니터링 ===
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# === Rate Limiting ===
# 사용자당 분당 최대 채팅 요청 수
RATE_LIMIT_MAX_PER_MINUTE=20

# === App ===
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production
