# ── 필수 아님: 키가 없으면 '데모/오프라인 모드'로 동작합니다 ──

# Claude (실시간 카드, 웹 확인, 질문 답변, 콜 종료 메모)
ANTHROPIC_API_KEY=

# 실시간 분석 모델 (기본: claude-opus-5-5). 지연이 거슬리면 claude-sonnet-5-5 / claude-haiku-5-5 로 바꿔보세요.
LIVE_MODEL=claude-opus-5-5
# 웹 확인·질문 답변·종료 메모 모델
DEEP_MODEL=claude-opus-5-5

# 로컬 전사 엔진 (npm run stt 로 켜는 whisper.cpp 서버). 오디오가 이 컴퓨터 밖으로 나가지 않음
LOCAL_STT_URL=http://127.0.0.1:8178
# whispercpp | openai (speaches, MLX 기반 서버 등 /v1/audio/transcriptions 호환 서버)
LOCAL_STT_API=whispercpp
# LOCAL_STT_API=openai 일 때 보낼 모델 이름
LOCAL_STT_MODEL=whisper-1

# (선택) Soniox 클라우드 음성인식 — 단어 단위 실시간, 한/영 혼용, 화자분리. 오디오가 Soniox 로 전송됨
SONIOX_API_KEY=

# 내 자료 폴더 (쉼표로 여러 개). .md .txt .csv .json .pdf 를 자동 색인
# 예: KB_DIRS=/Users/me/Obsidian/Research,/Users/me/Documents/CallNotes
KB_DIRS=

# 서버 포트 / 데이터 저장 위치
PORT=4100
DATA_DIR=./data
